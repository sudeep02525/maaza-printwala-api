# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/maaza-printwala?retryWrites=true&w=majority

# JWT Authentication (Access + Refresh Token Architecture)
# NOTE: In production (NODE_ENV=production), ACCESS_TOKEN_SECRET and REFRESH_TOKEN_SECRET
# MUST be set to unique, cryptographically strong random strings (cannot use dev defaults).
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_TOKEN_SECRET=dev_access_secret_key_change_in_prod
REFRESH_TOKEN_SECRET=dev_refresh_secret_key_change_in_prod
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=7d

# Allowed CORS Origins for HTTP & Socket.io (comma-separated, credentials: true)
# In production, specify storefront and admin panel domains, e.g.:
# CORS_ORIGINS=https://maazaprintwala.com,https://admin.maazaprintwala.com
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
STORAGE_PROVIDER=cloudinary # 'cloudinary' or 'local'

# Payment Configuration (Razorpay & Test Mode)
ENABLE_TEST_PAYMENTS=false # Set to true only in dev/testing environments
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Checkout & Cart Configuration
CHECKOUT_DRAFT_EXPIRY_HOURS=72

# Email & Notification System (SMTP)
SMTP_HOST=smtp.zoho.in # or smtp.resend.com, smtp.gmail.com
SMTP_PORT=465 # 465 (SSL) or 587 (TLS)
SMTP_SECURE=true # true for 465, false for 587
SMTP_USER=support@maazaprintwala.com
SMTP_PASS=your_smtp_app_password
SMTP_FROM="Maaza Printwala <support@maazaprintwala.com>"

