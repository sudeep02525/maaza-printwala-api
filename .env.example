# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/maaza-printwala?retryWrites=true&w=majority

# JWT Authentication (Access + Refresh Token Architecture)
# NOTE: In production (NODE_ENV=production), ACCESS_TOKEN_SECRET and REFRESH_TOKEN_SECRET
# MUST be set to unique, cryptographically strong random strings (cannot use dev defaults).
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_TOKEN_SECRET=dev_access_secret_key_change_in_prod
REFRESH_TOKEN_SECRET=dev_refresh_secret_key_change_in_prod
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=7d

# Allowed CORS Origins for HTTP & Socket.io (comma-separated, credentials: true)
# In production, specify storefront and admin panel domains, e.g.:
# CORS_ORIGINS=https://maazaprintwala.com,https://admin.maazaprintwala.com
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
